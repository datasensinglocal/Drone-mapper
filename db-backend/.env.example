# Copy this file to ".env" (same folder) and fill in the real values there.
# Never put real credentials in this .env.example file, and never paste them into chat.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# a password you make up yourself -- this is what the frontend (index.html) will send
# back to the backend to prove it's allowed to write to the database. Just invent a
# long random string, it doesn't need to mean anything.
API_TOKEN=
